# Server
API_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# File storage
UPLOAD_DIR=./uploads
FRAME_DIR=./frames
COVER_DIR=./covers
RENDER_DIR=./renders
SEED_VIDEO_DIR=./seed_assets/raw_videos

# Optional local binary overrides. Static npm binaries are used when these are empty.
FFMPEG_PATH=
FFPROBE_PATH=

# LLM provider, OpenAI-compatible format.
# For the competition build, prefer Ark / Doubao in real mode and keep mock mode available.
# Do not commit real keys.
LLM_PROVIDER=ark
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Doubao-Seed-2.0-lite
ENABLE_MOCK_AI=true

# Optional ASR / VLM provider
ASR_PROVIDER=manual_or_whisper
VLM_PROVIDER=manual_or_model

# Feature flags
ENABLE_AIGC_FILL=false
ENABLE_RENDER=false
