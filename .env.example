# Server
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# File storage
UPLOAD_DIR=./uploads
FRAME_DIR=./frames
COVER_DIR=./covers
RENDER_DIR=./renders
SEED_VIDEO_DIR=./seed_assets/raw_videos
ANALYSIS_DIR=./seed_assets/analysis
ASSET_LIBRARY_DIR=./seed_assets/asset_libraries

# Optional local binary overrides. Static npm binaries are used when these are empty.
FFMPEG_PATH=
FFPROBE_PATH=

# LLM provider, OpenAI-compatible format.
# For the competition build, prefer Ark / Doubao in real mode and keep mock mode available.
# Do not commit real keys.
LLM_PROVIDER=ark
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Doubao-Seed-2.0-lite
ENABLE_MOCK_AI=true

# ASR provider — defaults to Volcengine Doubao ASR 2.0 (recommended for 中文
# e-commerce short-video). ASR is INDEPENDENT of LLM_API_KEY: different product,
# different endpoint (openspeech.bytedance.com), different auth (AppID + Token).
# Open at 火山引擎控制台 → AI 中台 → 语音技术 → 大模型录音文件识别.
# Free trial: 20 hours, then pay-as-you-go (~0.9–1.8 RMB/h).
# Alternative providers: funasr (local Paraformer) | faster_whisper (local) |
#                       manual_or_whisper (no ASR run).
ASR_PROVIDER=volcengine
ASR_BASE_URL=https://openspeech.bytedance.com
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_SECRET_KEY=

# Optional Asset Manager VLM enhancement.
# Default is off; the main demo uses deterministic analysis and does not depend on this.
ASSET_VLM_ENABLED=false
ASSET_VLM_PROVIDER=openai_compatible
ASSET_VLM_MODEL=
ASSET_VLM_MAX_KEYFRAMES=5

# Legacy VLM note for old scripts/docs; prefer ASSET_VLM_* for the Asset Manager.
VLM_PROVIDER=manual_or_model

# Feature flags
ENABLE_AIGC_FILL=false
ENABLE_RENDER=false
# Opt-in: author a SECOND real-pixel render via the LLM Director (or the deterministic mock
# author when no LLM creds). When true, POST /api/demo/run spawns ffmpeg twice and may make a
# real LLM API call (30s timeout). Default off.
USE_AUTHORED_RENDER=false
# Opt-in: the LLM (Doubao) authors a HyperFrames composition (HTML + GSAP) and HyperFrames
# renders it (headless Chrome -> ffmpeg) — rich motion/effects. Needs Node>=22 + ffmpeg + Chrome
# (one-time: npx hyperframes browser ensure). When true, POST /api/demo/run also produces a
# HyperFrames ad. Default off.
USE_HYPERFRAMES_RENDER=false
# Pinned HyperFrames CLI version spawned via npx (determinism: pixels drift across versions).
HYPERFRAMES_VERSION=hyperframes@0.6.80
