# apps/api/.env — template. Copy to apps/api/.env and fill in real values.
# NEVER commit the real .env (it holds secrets). Only this .example is tracked.

# Server
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# File storage
UPLOAD_DIR=./uploads
FRAME_DIR=./frames
COVER_DIR=./covers
RENDER_DIR=./renders

# LLM provider, OpenAI-compatible format (Ark / Doubao in real mode; mock otherwise).
# Do not commit real keys.
LLM_PROVIDER=ark
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Doubao-Seed-2.0-lite
ENABLE_MOCK_AI=true

# ASR — fill after opening 火山引擎 "语音技术 → 大模型录音文件识别" app.
# Independent product from ARK Chat; cannot reuse LLM_API_KEY.
ASR_PROVIDER=volcengine
ASR_BASE_URL=https://openspeech.bytedance.com
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_SECRET_KEY=

# Legacy VLM note for old scripts/docs; prefer ASSET_VLM_* for the Asset Manager.
VLM_PROVIDER=manual_or_model

# Feature flags
ENABLE_AIGC_FILL=false
ENABLE_RENDER=false

# Optional local binary overrides. Static npm binaries are used when these are empty.
FFMPEG_PATH=
FFPROBE_PATH=

# === AIGC (Wan2.7 / Aliyun DashScope) — required for real 成片 produce ===
# Read by apps/api/src/services/videoAgent/wanVideoClient.ts -> wanConfigFromEnv().
# Only these THREE are read by code today; the WAN_MODEL_*/WAN_RESOLUTION/WAN_MAX_CONCURRENCY/
# WAN_CACHE_DIR below are documented in docs/aigc-helper-video-pipeline.md §13 but NOT yet read
# (resolution '720P', concurrency 4, and work dir tmp/aigc_beats are hardcoded in the runner).
DASHSCOPE_API_KEY=                                  # Aliyun Model Studio key; REQUIRED for AIGC video generation
WAN_WORKSPACE_ID=                                   # DashScope workspace id (ws-...); optional, sent as X-DashScope-WorkSpace
WAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1  # Global Beijing endpoint; do NOT use the *.maas.aliyuncs.com host

# --- Documented in docs §13 but not yet read by code (future config; leave as-is) ---
# WAN_MODEL_R2V=wan2.7-r2v                           # reference-to-video model (image match + true gaps)
# WAN_MODEL_I2V=wan2.7-i2v                           # image-to-video (reserved; 待确认开通)
# WAN_MODEL_VIDEOEDIT=wan2.7-videoedit               # video-edit model (partial video beats)
# WAN_MODEL_T2V=wan2.7-t2v                           # text-to-video fallback (no product image)
# WAN_RESOLUTION=720P                                # output resolution (720P|1080P); currently hardcoded to 720P
# WAN_MAX_CONCURRENCY=4                              # max concurrent Wan generations; currently hardcoded to 4
# WAN_CACHE_DIR=tmp/wan_cache                        # generated-clip cache/work dir; runner currently uses tmp/aigc_beats
